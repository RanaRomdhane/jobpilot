# JobPilot configuration. Copy to `.env` with `make env` (which also generates the secrets
# marked "generated"), then fill in the API keys yourself. Never commit `.env`.

# --- runtime
ENV=dev
LOG_LEVEL=INFO
# keep email/job bodies out of logs (recommended)
LOG_REDACT_BODIES=true

# --- infrastructure (docker-compose overrides DATABASE_URL/REDIS_URL inside containers)
POSTGRES_PASSWORD=change-me              # generated by `make env`
POSTGRES_HOST_PORT=5433                  # 5433 so a locally installed PostgreSQL keeps 5432
REDIS_HOST_PORT=6379
DATABASE_URL=postgresql+asyncpg://jobpilot:change-me@127.0.0.1:5433/jobpilot
REDIS_URL=redis://127.0.0.1:6379/0

# --- security
# Fernet key encrypting OAuth tokens at rest. Generated by `make env`; losing it means re-connecting Gmail.
FERNET_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM provider: "groq" (default) or "openai". Switching needs no code change.
LLM_PROVIDER=groq
GROQ_API_KEY=                            # https://console.groq.com/keys
OPENAI_API_KEY=                          # optional
LLM_FALLBACK_TO_OPENAI=false             # use OpenAI when Groq's budget would make us wait too long

# Model per purpose (defaults shown; uncomment to override)
# GROQ_MODEL_TRIAGE=openai/gpt-oss-120b
# GROQ_MODEL_GUARD=openai/gpt-oss-120b
# GROQ_MODEL_PARSE_RESUME=openai/gpt-oss-120b
# GROQ_MODEL_RERANK=openai/gpt-oss-120b
# GROQ_MODEL_TAILOR=openai/gpt-oss-120b
# GROQ_MODEL_COVER_LETTER=openai/gpt-oss-120b
# OPENAI_MODEL_TRIAGE=gpt-4.1-mini

# Rate limits, enforced globally across all processes through Redis.
# Check yours at https://console.groq.com/settings/limits
GROQ_TPM=8000
GROQ_RPM=30
GROQ_TPD=200000

# --- inbox triage
TRIAGE_BATCH_SIZE=15
